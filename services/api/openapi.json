{
  "components": {
    "schemas": {
      "BindingDecisionRequest": {
        "additionalProperties": false,
        "properties": {
          "action": {
            "enum": [
              "APPROVE_BINDING",
              "REJECT_BINDING"
            ],
            "title": "Action",
            "type": "string"
          },
          "binding_digest": {
            "pattern": "^[0-9a-f]{64}$",
            "title": "Binding Digest",
            "type": "string"
          },
          "comment": {
            "anyOf": [
              {
                "maxLength": 2000,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Comment"
          }
        },
        "required": [
          "action",
          "binding_digest"
        ],
        "title": "BindingDecisionRequest",
        "type": "object"
      },
      "CancelRequest": {
        "additionalProperties": false,
        "properties": {
          "comment": {
            "anyOf": [
              {
                "maxLength": 2000,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Comment"
          }
        },
        "title": "CancelRequest",
        "type": "object"
      },
      "CorrectionRequest": {
        "additionalProperties": false,
        "properties": {
          "comment": {
            "anyOf": [
              {
                "maxLength": 2000,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Comment"
          },
          "head_sha": {
            "pattern": "^[0-9a-f]{40}$",
            "title": "Head Sha",
            "type": "string"
          }
        },
        "required": [
          "head_sha"
        ],
        "title": "CorrectionRequest",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
